---
/* Projects one to a row, like the experience: a picture of each in the
   first column, its name over what it is in the second. The whole row is
   the link. */
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { projectPath } from "../data/projects";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

/* An OG card's shape, 1200:630, at twice the widest it's shown (a third of
   the page, about 230px). */
const crop = { width: 480, height: 252, fit: "cover", format: "webp" } as const;
const dark = "(prefers-color-scheme: dark)";

const rows = await Promise.all(
  projects.map(async (project) => {
    const { thumb, thumbDark, shots } = project.data;
    const cover = shots?.find((s) => s.src);
    const light = thumb ?? cover?.src;
    const night = thumb ? thumbDark : cover?.srcDark;
    return {
      project,
      light: light && (await getImage({ src: light, ...crop })),
      night: night && (await getImage({ src: night, ...crop })),
    };
  }),
);
---

<ul class="rows" role="list">
  {
    rows.map(({ project, light, night }) => (
      <li>
        <a class="btn block" href={projectPath(project.id)}>
          <span class="project">
            <span class="thumb">
              {light && (
                <picture>
                  {night && (
                    <source media={dark} srcset={night.src} type="image/webp" />
                  )}
                  <img
                    src={light.src}
                    alt=""
                    width={crop.width}
                    height={crop.height}
                    loading="eager"
                    decoding="async"
                  />
                </picture>
              )}
            </span>
            <span class="title">
              <span>{project.data.title}</span>
              <span>{project.data.summary}</span>
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
