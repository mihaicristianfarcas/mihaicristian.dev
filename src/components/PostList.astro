---
/* Posts one to a row: the title over its description, and the date at the
   end of the row. The whole row is the link. */
import type { CollectionEntry } from "astro:content";
import { postDateFmt, postPath } from "../data/writing";

interface Props {
  posts: CollectionEntry<"writing">[];
}

const { posts } = Astro.props;
---

<ul class="rows" role="list">
  {
    posts.map((post) => (
      <li>
        <a class="btn block" href={postPath(post.id)}>
          <span class="post">
            <span class="title">
              <span>{post.data.title}</span>
              <span>{post.data.description}</span>
            </span>
            <time class="meta" datetime={post.data.date.toISOString().slice(0, 10)}>
              {postDateFmt.format(post.data.date)}
            </time>
          </span>
        </a>
      </li>
    ))
  }
</ul>
