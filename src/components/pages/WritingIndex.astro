---
import Base from "../../layouts/Base.astro";
import Back from "../Back.astro";
import PostList from "../PostList.astro";
import { getPostsByYear } from "../../data/writing";

const years = await getPostsByYear();
---

<Base
  title="Writing"
  description="Essays and notes by Mihai-Cristian Farcaș on software engineering, coding with AI, study, and life beyond the screen."
>
  <section class="wrap hero">
    <div class="title">
      <h1>Writing</h1>
      <p class="lede">
        {years.length > 0 ? "Notes on software and life." : "Nothing here yet."}
        There's an <a href="/rss.xml">RSS feed</a>
        {years.length > 0 ? "for new posts." : "to catch the first post."}
      </p>
    </div>
  </section>

  {
    years.map((y) => (
      <section class="wrap section" aria-labelledby={`y${y.year}`}>
        <h2 id={`y${y.year}`}>{y.year}</h2>
        <PostList posts={y.posts} described day />
      </section>
    ))
  }

  <Back />
</Base>
