---
/* Every post, newest first, each with its description. */
import Base from "../../layouts/Base.astro";
import PostList from "../PostList.astro";
import { getPosts } from "../../data/writing";

const posts = await getPosts();
---

<Base
  title="Writing"
  description="Essays and notes by Mihai-Cristian Farcaș on software engineering, coding with AI, study, and life beyond the screen."
  section="writing"
>
  <h1 class="sr-only">Writing</h1>
  {
    posts.length > 0 ? (
      <PostList posts={posts} described />
    ) : (
      <p>Nothing here yet.</p>
    )
  }
</Base>
