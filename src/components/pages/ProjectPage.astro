---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Pager from "../Pager.astro";
import Shot from "../Shot.astro";
import { getProjectNeighbours } from "../../data/projects";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { prev, next } = await getProjectNeighbours(project.id);

const { years, role, status, tech, links, shots } = project.data;
/* Shots without a src would render placeholder frames; skip them until the
   real screenshots exist. */
const [cover, ...rest] = (shots ?? []).filter((s) => s.src);
/* The links sit in a row under the details, in their listed order. */
const actions = (links ?? []).map((l) => ({
  ...l,
  newTab: l.newTab || l.href.startsWith("http"),
}));
---

<Base
  title={project.data.title}
  description={project.data.description}
  section="projects"
>
  <header class="title">
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.description}</p>
  </header>

  <article class="entry">
    {cover && <Shot {...cover} cover />}
    <div class="prose">
      <Content />
    </div>
    {rest.map((s) => <Shot {...s} />)}
  </article>

  <section class="section" aria-labelledby="details">
    <h2 id="details">Details</h2>
    <dl class="keys">
      <div>
        <dt>Years</dt>
        <dd>{years}</dd>
      </div>
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>{status}</dd>
      </div>
      <div>
        <dt>Built with</dt>
        <dd>{tech}</dd>
      </div>
    </dl>
    {
      actions.length > 0 && (
        <div class="cta">
          {actions.map((l) => (
            <a
              class="more"
              href={l.href}
              target={l.newTab ? "_blank" : undefined}
              rel={l.newTab ? "noopener" : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </section>

  <Pager
    label="More projects"
    prev={prev && { ...prev, word: "Previous" }}
    next={next && { ...next, word: "Next" }}
  />
</Base>

