---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Pager from "../Pager.astro";
import Shot from "../Shot.astro";
import { getProjectNeighbours } from "../../data/projects";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { prev, next } = await getProjectNeighbours(project.id);

const { years, role, status, tech, links, features, shots } = project.data;
/* Shots without a src would render placeholder frames; skip them until the
   real screenshots exist. */
const [cover, ...rest] = (shots ?? []).filter((s) => s.src);
/* The first link is the page's button; the rest sit beside it. */
const [primary, ...others] = (links ?? []).map((l) => ({
  ...l,
  newTab: l.newTab || l.href.startsWith("http"),
}));
---

<Base title={project.data.title} description={project.data.description}>
  <section class="wrap hero">
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.description}</p>
    {
      primary && (
        <div class="cta">
          <a
            class="button"
            href={primary.href}
            target={primary.newTab ? "_blank" : undefined}
            rel={primary.newTab ? "noopener" : undefined}
          >
            {primary.label}
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 11 11 5M6 5h5v5" />
            </svg>
          </a>
          {others.map((l) => (
            <a
              class="more"
              href={l.href}
              target={l.newTab ? "_blank" : undefined}
              rel={l.newTab ? "noopener" : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </section>

  {
    cover && (
      <section class="wrap cover-shot" aria-label="Cover">
        <Shot {...cover} cover />
      </section>
    )
  }

  <article class="wrap prose">
    <Content />
  </article>

  <section class="wrap section" aria-labelledby="features">
    <h2 id="features">What it does</h2>
    <ul class="grid" role="list">
      {
        features.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    rest.length > 0 && (
      <section class="wrap section shots" aria-label="Screenshots">
        {rest.map((s) => (
          <Shot {...s} />
        ))}
      </section>
    )
  }

  <section class="wrap section" aria-labelledby="details">
    <h2 id="details">Details</h2>
    <dl class="keys">
      <dt>Years</dt>
      <dd>{years}</dd>
      <dt>Role</dt>
      <dd>{role}</dd>
      <dt>Status</dt>
      <dd>{status}</dd>
      <dt>Built with</dt>
      <dd>{tech}</dd>
    </dl>
  </section>

  <Pager
    label="More projects"
    prev={prev && { ...prev, word: "Previous" }}
    next={next && { ...next, word: "Next" }}
  />
</Base>

<style>
  .cover-shot {
    padding-top: var(--hero-gap);
  }

  /* Screenshots sit further apart than the blocks of a section do. */
  .shots {
    gap: calc(var(--gap) * 2);
  }

  .shots :global(figure) {
    max-width: min(var(--w, 100%), var(--figure));
  }
</style>
