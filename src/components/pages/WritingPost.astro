---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Back from "../Back.astro";
import Pager from "../Pager.astro";
import { getPostNeighbours, postDateFmt } from "../../data/writing";

interface Props {
	post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { newer, older } = await getPostNeighbours(post.id);
---

<Base
  title={post.data.title}
  description={post.data.description}
  publishedTime={post.data.date}
>
  <section class="wrap hero">
    <div class="title">
      <h1>{post.data.title}</h1>
      <p>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {postDateFmt.format(post.data.date)}
        </time>
      </p>
    </div>
  </section>

  <article class="wrap prose">
    <Content />
  </article>

  <Back />

  <Pager
    label="More writing"
    prev={newer && { ...newer, word: "Newer" }}
    next={older && { ...older, word: "Older" }}
  />
</Base>

<style>
  /* The text starts one empty line under the date, the same as every gap
     inside it. */
  .prose {
    padding-top: var(--gap);
  }
</style>
