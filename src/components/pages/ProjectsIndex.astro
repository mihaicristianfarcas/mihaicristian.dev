---
/* Every project, in its group, the most impressive first. */
import Base from "../../layouts/Base.astro";
import ProjectList from "../ProjectList.astro";
import { getProjectGroups } from "../../data/projects";

const groups = await getProjectGroups();
---

<Base
  title="Projects"
  description="Explore software projects by Mihai-Cristian Farcaș, from networking, cryptography, and systems research to AI products and developer tools."
  section="projects"
>
  <h1 class="sr-only">Projects</h1>
  <div class="parts">
    {
      groups.map(({ group, projects }) => (
        <section>
          <h2 class="meta">{group}</h2>
          <ProjectList projects={projects} />
        </section>
      ))
    }
  </div>
</Base>
