---
/* Every project, the selected ones first. */
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../ProjectGrid.astro";
import { getProjects } from "../../data/projects";

const projects = await getProjects();
---

<Base
  title="Projects"
  description="Explore software projects by Mihai-Cristian Farcaș, from networking, cryptography, and systems research to AI products and developer tools."
  section="projects"
>
  <h1 class="sr-only">Projects</h1>
  <ProjectGrid projects={projects} />
</Base>
