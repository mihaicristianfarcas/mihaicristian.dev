---
/* The homepage: a few lines about me. */
import Base from "../../layouts/Base.astro";

const ubb = "https://www.ubbcluj.ro/ro/";
---

<Base>
  <div class="about">
    <p>
      I build tools for technical work, from network software to AI products.
    </p>
    <p>
      Right now I'm studying for an MSc in cloud and network systems at <a
        href={ubb}
        target="_blank"
        rel="noopener">Babeș-Bolyai University</a
      >.
    </p>
    <p>
      Living life thinking about computers, philosophy, history and legends,
      with a touch of optimism and introspection.
    </p>
  </div>
</Base>

<style>
  /* One empty line between paragraphs, like every list. */
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .about p {
    color: var(--body);
    text-wrap: pretty;
  }
</style>
