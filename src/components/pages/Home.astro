---
/* The homepage content. */
import Base from "../../layouts/Base.astro";
import ProjectGrid from "../ProjectGrid.astro";
import PostList from "../PostList.astro";
import { site } from "../../data/site";
import { quotes } from "../../data/quotes";
import { getProjects, projectPath } from "../../data/projects";
import { getPosts } from "../../data/writing";

const posts = (await getPosts()).slice(0, 3);
const projects = (await getProjects())
  .filter((p) => p.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);

const email = site.links.find((l) => l.label === "Email")!;
const cv = site.links.find((l) => l.label === "CV")!;
const ubb = "https://www.ubbcluj.ro/ro/";
---

<Base>
  <section class="wrap hero">
    <h1>I build tools for technical work, from network software to AI products.</h1>
    <p class="lede">
      Based in Cluj-Napoca, Romania, and studying for an MSc in cloud and
      network systems at <a href={ubb} target="_blank" rel="noopener"
        >Babeș-Bolyai University</a
      >. Open to work.
    </p>
    <div class="cta">
      <a class="button" href={email.href}>
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="1.75" y="3.25" width="12.5" height="9.5" rx="2"></rect><path
            d="m2.5 4.5 5.5 4.25 5.5-4.25"></path></svg
        >
        Email me
      </a>
      <a class="more" href={cv.href} target="_blank" rel="noopener">
        Read my CV
      </a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="projects">
    <h2 id="projects">Selected projects</h2>
    <ProjectGrid projects={projects} />
    <a class="more" href="/projects/">All projects →</a>
  </section>

  <section class="wrap section" aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    <dl class="keys">
      <dt><a href={projectPath("blueplan")}>BluePlan</a></dt>
      <dd>
        Freelancing, these days. I built <a href={projectPath("atlas")}>Atlas</a>
        there, a tool that helps engineering teams find answers in technical documents
        and check them against the original pages.
      </dd>
      <dt>
        <a href="https://x.com/baseline_co_" target="_blank" rel="noopener"
          >Baseline Studio</a
        >
      </dt>
      <dd>Built client apps across the stack.</dd>
      <dt>GeoDraw</dt>
      <dd>Worked on the AI wireframing canvas.</dd>
      <dt>Tvarita</dt>
      <dd>Redesigned a monitoring site for optician clinics.</dd>
      <dt>
        <a href={ubb} target="_blank" rel="noopener">Babeș-Bolyai University</a>
      </dt>
      <dd>
        Studied computer science, and now an MSc in cloud and network systems.
      </dd>
    </dl>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap section" aria-labelledby="writing">
        <h2 id="writing">Writing</h2>
        <PostList posts={posts} />
        <a class="more" href="/writing/">
          All writing →
        </a>
      </section>
    )
  }

  <section class="wrap section quote" aria-label="A quote">
    <figure>
      <blockquote>
        <p id="q-text">{quotes[0].text}</p>
      </blockquote>
      <figcaption id="q-author">{quotes[0].author}</figcaption>
    </figure>
    {
      /* data-astro-rerun: the router skips inline scripts it has already
        run, which would pin the quote to the SSR default on return visits. */
    }
    <script is:inline data-astro-rerun define:vars={{ quotes }}>
      const q = quotes[Math.floor(Math.random() * quotes.length)];
      document.getElementById("q-text").textContent = q.text;
      document.getElementById("q-author").textContent = q.author;
    </script>
  </section>
</Base>

<style>
  .quote blockquote {
    max-width: 36em;
    text-wrap: pretty;
  }

  .quote figcaption {
    margin-top: 4px;
  }
</style>
