---
/* The homepage content. */
import Base from "../../layouts/Base.astro";
import PassionPattern from "../PassionPattern.astro";
import avatar from "../../assets/avatar.webp?inline";
import { site } from "../../data/site";
import { quotes } from "../../data/quotes";
import { getProjects, projectPath } from "../../data/projects";
import { getPosts, postDateFmt, postPath } from "../../data/writing";

const posts = (await getPosts()).slice(0, 3);
const projects = (await getProjects()).filter((p) => p.data.featured);
---

<Base router>
  <header class="s" style="--i: 0">
    <div class="id">
      {/* alt="": the name is right beside it. */}
      <img
        class="avatar"
        src={avatar}
        alt=""
        width="56"
        height="56"
        decoding="sync"
      />
      <div>
        <h1>Mihai-Cristian Farcaș</h1>
        <p class="role mono">Systems software engineer</p>
      </div>
    </div>
    <p class="intro">
      I build tools for technical work, from network software to AI products.
      Based in Cluj-Napoca, Romania.
    </p>
    <ul class="links mono" role="list">
      {
        site.links.map((l) => {
          const newTab = l.newTab || l.href.startsWith("http");
          return (
            <li>
              <a
                href={l.href}
                target={newTab ? "_blank" : undefined}
                rel={newTab ? "noopener" : undefined}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </header>

  <section class="s" style="--i: 1" aria-labelledby="now">
    <h2 id="now">Now</h2>
    <p>
      MSc in cloud and network systems at Babeș-Bolyai University. Freelancing
      with BluePlan; open to work.
    </p>
  </section>

  <section class="s" style="--i: 2" aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    <ul role="list">
      {
        [
          {
            org: "BluePlan",
            line: "Built Atlas, a document search platform.",
          },
          {
            org: "Baseline Studios",
            line: "Built client apps across the stack.",
          },
          {
            org: "GeoDraw",
            line: "Built an AI wireframing canvas.",
          },
          {
            org: "Tvarita",
            line: "Redesigned a monitoring site for optician clinics.",
          },
        ].map((e) => (
          <li class="xp">
            <span class="org">{e.org}</span> — {e.line}
          </li>
        ))
      }
    </ul>
    <p class="edu">
      BSc in Computer Science · Babeș-Bolyai University.
    </p>
  </section>

  <section class="s" style="--i: 3" aria-labelledby="projects">
    <h2 id="projects">Selected projects</h2>
    <ul role="list">
      {
        projects.map((p) => (
          <li class="project">
            <h3>
              <a href={projectPath(p.id)}>{p.data.title}</a>
              <span class="mono tech">{p.data.tech}</span>
            </h3>
            <p>{p.data.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="all">
      <a href="/projects/">
        All projects <span class="arrow">→</span>
      </a>
    </p>
  </section>

  <section class="s" style="--i: 4" aria-labelledby="writing">
    <h2 id="writing">Writing</h2>
    {
      posts.length > 0 ? (
        <ul role="list">
          {posts.map((post) => (
            <li class="post">
              <a href={postPath(post.id)}>{post.data.title}</a>
              <span class="mono">{postDateFmt.format(post.data.date)}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">
          Notes on software and life, coming soon. There’s an{" "}
          <a href="/rss.xml">RSS feed</a> for when they do.
        </p>
      )
    }
    {
      posts.length > 0 && (
        <p class="all">
          <a href="/writing/">
            All writing <span class="arrow">→</span>
          </a>
        </p>
      )
    }
  </section>

  <aside class="s quote" style="--i: 5">
    <blockquote>
      <p id="q-text">{quotes[0].text}</p>
      <footer class="mono" id="q-author">— {quotes[0].author}</footer>
    </blockquote>
    {
      /* data-astro-rerun: the router skips inline scripts it has already
        run, which would pin the quote to the SSR default on return visits. */
    }
    <script is:inline data-astro-rerun define:vars={{ quotes }}>
      const q = quotes[Math.floor(Math.random() * quotes.length)];
      document.getElementById("q-text").textContent = q.text;
      document.getElementById("q-author").textContent = `— ${q.author}`;
    </script>
  </aside>

  <PassionPattern />
</Base>

<style>
  .id {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .avatar {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    pointer-events: none;
  }

  .role {
    margin-top: 0.125rem;
  }

  header p.intro {
    margin-top: 1.25rem;
  }

  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
  }

  .links a {
    color: var(--muted);
  }

  .links a:hover {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .links {
      gap: 0.5rem 1rem;
    }
  }

  section {
    margin-top: 3.5rem;
  }

  section > p,
  section > ul {
    margin-top: 0.875rem;
  }

  section ul {
    list-style: none;
    padding: 0;
  }

  .project {
    margin: 0 -0.875rem;
    padding: 0.875rem;
    border-radius: 8px;
  }

  .project + .project {
    margin-top: 0.25rem;
  }

  .project h3 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project p {
    color: var(--muted);
    margin-top: 0.25rem;
    font-size: 0.9375rem;
  }

  .xp + .xp {
    margin-top: 0.5rem;
  }

  .org {
    font-weight: 550;
  }

  .edu {
    color: var(--muted);
    margin-top: 0.875rem;
    font-size: 0.9375rem;
  }

  .post {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .post + .post {
    margin-top: 0.5rem;
  }

  .post .mono {
    white-space: nowrap;
  }

  .empty,
  .all {
    color: var(--muted);
  }

  .all {
    margin-top: 0.875rem;
  }

  /* ---- the quote: one thing allowed to be a little theatrical ---- */

  .quote {
    margin-top: 4.5rem;
    position: relative;
  }

  .quote blockquote {
    padding: 0;
  }

  .quote blockquote::before {
    content: "\201C";
    display: block;
    font-family: var(--font-meslo);
    color: var(--accent);
    font-size: 1.375rem;
    line-height: 1;
    opacity: 0.65;
    margin-bottom: 0.375rem;
  }

  .quote p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .quote footer {
    margin-top: 0.625rem;
  }
</style>
