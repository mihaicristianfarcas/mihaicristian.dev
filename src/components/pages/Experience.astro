---
/* Where I've worked and studied. */
import Base from "../../layouts/Base.astro";
import { projectPath } from "../../data/projects";

const ubb = "https://www.ubbcluj.ro/ro/";
---

<Base
  title="Experience"
  description="Where Mihai-Cristian Farcaș has worked and studied: BluePlan, Baseline Studio, GeoDraw, Tvarita, and Babeș-Bolyai University."
  section="experience"
>
  <h1 class="sr-only">Experience</h1>
  <dl class="keys">
    <div>
      <dt><a href={projectPath("blueplan")}>BluePlan</a></dt>
      <dd>
        Created <a href={projectPath("atlas")}>Atlas</a>, a tool for finding
        and checking answers in technical documents.
      </dd>
    </div>
    <div>
      <dt>
        <a href="https://x.com/baseline_co_" target="_blank" rel="noopener"
          >Baseline Studio</a
        >
      </dt>
      <dd>Built client apps across the stack.</dd>
    </div>
    <div>
      <dt>GeoDraw</dt>
      <dd>Worked on the AI wireframing canvas.</dd>
    </div>
    <div>
      <dt>
        <a href="https://www.tvarita.ro" target="_blank" rel="noopener"
          >Tvarita</a
        >
      </dt>
      <dd>Redesigned a monitoring site for optician clinics.</dd>
    </div>
    <div>
      <dt>
        <a href={ubb} target="_blank" rel="noopener">Babeș-Bolyai University</a>
      </dt>
      <dd>
        Studied computer science, and now an MSc in cloud and network systems.
      </dd>
    </div>
  </dl>
</Base>
