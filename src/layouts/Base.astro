---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { site, person } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  publishedTime?: Date;
  structuredData?: Record<string, unknown>;
  /* The "Go back" link at the top. The homepage leaves it out: there's
     nowhere further back to go, and its own title is the name. */
  header?: boolean;
}

const {
  title,
  noindex = false,
  publishedTime,
  structuredData,
  header = true,
} = Astro.props;
const description = Astro.props.description ?? site.description;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} | Software Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
/* Where "Go back" leads when the visit started on this page: a project or a
   post goes to its section's index, anything else home. */
const parent = /^\/(projects|writing)\/[^/]+/.test(path)
  ? `/${path.split("/")[1]}/`
  : "/";

const feed = new URL("/rss.xml", Astro.site);
const websiteId = `${site.url}/#website`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: "en",
      publisher: { "@id": person["@id"] },
    },
    {
      "@type": path === "/" ? "ProfilePage" : "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: pageTitle,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      ...(path === "/" && {
        mainEntity: { "@id": person["@id"] },
      }),
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
{
  /* No root crossfade: the swap is instant and the fade in global.css is the
    transition, so client navigations and hard loads look the same. */
}
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#282725"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      /* Holds the page until the DOM and its media are ready, then lets the
         fade in global.css run — see `[data-loading]` there. Inline and
         above the stylesheet so the attribute is set before the first paint.
         With JS off it is never set and the page renders as normal. */
      (() => {
        const root = document.documentElement;
        root.dataset.loading = "";

        const reveal = () => delete root.dataset.loading;

        const domReady = new Promise((done) => {
          if (document.readyState !== "loading") done();
          else
            document.addEventListener("DOMContentLoaded", done, { once: true });
        });

        /* Nothing loads lazily, so the page holds for its media: every
           image, and every video's poster, decoded before the fade. A
           recording's poster is its first frame, so the page arrives whole
           and the video takes over from there. */
        const decoded = async (image) => {
          try {
            await image.decode();
          } catch {}
        };
        const poster = (video) => {
          const image = new Image();
          image.src = video.poster;
          return decoded(image);
        };
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        const mediaLoaded = domReady.then(() => {
          /* A recording with a poster per theme gets the one that matches,
             here rather than in the markup, so only that one downloads. */
          for (const video of document.querySelectorAll("video[data-poster]"))
            video.poster =
              (dark && video.dataset.posterDark) || video.dataset.poster;
          return Promise.all([
            ...[...document.images].map(decoded),
            ...[...document.querySelectorAll("video[poster]")].map(poster),
          ]);
        });

        /* Both handlers: a rejection here should still show the page. */
        mediaLoaded.then(reveal, reveal);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={feed}
    />
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      publishedTime && (
        <meta property="article:author" content={`${site.url}/`} />
      )
    }
    <meta name="twitter:card" content="summary" />
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <script>
      /* "Go back" goes back when the page before this one is on this site:
         the router numbers its history entries from 0, on the page a visit
         lands on. A visit that lands here instead follows the link to the
         page's parent. A modified click opens the link as usual. Capture, so
         the router, which leaves handled clicks alone, sees it handled. */
      document.addEventListener(
        "click",
        (event) => {
          const link = (event.target as Element).closest?.("a[data-back]");
          if (
            !link ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            !((history.state?.index ?? 0) > 0)
          )
            return;
          event.preventDefault();
          history.back();
        },
        true,
      );
    </script>
    <script>
      /* The router's side of the hold in <head>: fetch the next page, then
         decode its images and posters before swapping it in, so a client-side
         navigation arrives whole too. The incoming document is detached and
         loads nothing itself; these warm the cache its elements then hit. */
      async function warm(src: string, srcset = "", sizes = "") {
        const image = new Image();
        image.sizes = sizes;
        image.srcset = srcset;
        if (src) image.src = src;
        try {
          await image.decode();
        } catch {}
      }

      document.addEventListener("astro:before-preparation", (event) => {
        const load = event.loader;
        event.loader = async () => {
          await load();
          const next = event.newDocument;
          const dark = matchMedia("(prefers-color-scheme: dark)").matches;
          for (const video of next.querySelectorAll<HTMLVideoElement>(
            "video[data-poster]",
          ))
            video.setAttribute(
              "poster",
              (dark && video.dataset.posterDark) || video.dataset.poster || "",
            );
          await Promise.all([
            ...[...next.images].map((img) => {
              /* Inside a <picture>, warm the source the browser will pick for
                 this theme, not the fallback. */
              const source = img.parentElement?.matches("picture")
                ? [...img.parentElement.querySelectorAll("source")].find(
                    (s) => !s.media || matchMedia(s.media).matches,
                  )
                : undefined;
              return source
                ? warm("", source.srcset, source.sizes)
                : warm(img.src, img.srcset, img.sizes);
            }),
            ...[
              ...next.querySelectorAll<HTMLVideoElement>("video[poster]"),
            ].map((video) => warm(video.poster)),
          ]);
        };
      });
    </script>
    {
      header && (
        <header class="wrap top">
          <a class="back" href={parent} data-back>
            ← Go back
          </a>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    <footer class="wrap">
      <div class="foot">
        <nav aria-label="Elsewhere">
          {
            site.links.map((l) => {
              const newTab = l.newTab || l.href.startsWith("http");
              return (
                <a
                  href={l.href}
                  target={newTab ? "_blank" : undefined}
                  rel={newTab ? "noopener" : undefined}
                >
                  {l.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </footer>
  </body>
</html>
