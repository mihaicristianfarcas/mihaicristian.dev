---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
import Mesh from "../components/Mesh.astro";
import { site, person } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  publishedTime?: Date;
  structuredData?: Record<string, unknown>;
  /* The part of the site the page belongs to, lit in the side. */
  section?: (typeof sections)[number]["id"];
}

/* The site's three parts, named in the side on every page. */
const sections = [
  { id: "projects", href: "/projects/", label: "Projects" },
  { id: "experience", href: "/experience/", label: "Experience" },
  { id: "writing", href: "/writing/", label: "Writing" },
] as const;

const {
  title,
  noindex = false,
  publishedTime,
  structuredData,
  section,
} = Astro.props;
const description = Astro.props.description ?? site.description;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} | Software Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
/* The name heads the homepage; every other page has a title of its own. */
const Name = path === "/" ? "h1" : "p";

const feed = new URL("/rss.xml", Astro.site);
const websiteId = `${site.url}/#website`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: "en",
      publisher: { "@id": person["@id"] },
    },
    {
      "@type": path === "/" ? "ProfilePage" : "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: pageTitle,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      ...(path === "/" && {
        mainEntity: { "@id": person["@id"] },
      }),
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
{
  /* No root crossfade: the swap is instant and the fade in global.css is the
    transition, so client navigations and hard loads look the same. */
}
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    {
      /* `cover`: in landscape the sky runs out under the notch too, and the
        page keeps clear of it (see .wrap). */
    }
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    {
      /* The sky's top, for the bar over the page in Chrome on Android.
        Safari ignores it since 26: see .tint in global.css. */
    }
    <meta
      name="theme-color"
      content="#a7cbee"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#050a16"
      media="(prefers-color-scheme: dark)"
    />
    {
      /* Preloaded, so the side's text is in Geist from the first paint, and
        above the script, which loads it. */
    }
    <Font cssVariable="--font-geist" preload />
    <script is:inline>
      /* Holds the page's content until everything on it has loaded, fonts,
         images, posters and recordings, then lets the fade in global.css
         run — see `[data-loading]` there. The side and the background don't
         wait: they show from the first paint. Nothing on the site loads
         lazily. Inline and above the stylesheet so the attribute is set
         before the first paint. With JS off it is never set and the page
         renders as normal. */
      (() => {
        const root = document.documentElement;
        root.dataset.loading = "";
        root.dataset.fontLoading = "";

        const reveal = () => delete root.dataset.loading;

        /* Geist's faces, the only ones declared above. Settled, not all
           resolved: a fallback face can fail on a system without its font,
           and that shouldn't hold anything. */
        const fontLoaded = Promise.allSettled(
          [...document.fonts].map((face) => face.load()),
        ).then(() => delete root.dataset.fontLoading);

        const dark = matchMedia("(prefers-color-scheme: dark)");

        /* An image is in once it has decoded, or failed to. */
        const decoded = async (image) => {
          try {
            await image.decode();
          } catch {}
        };
        const warm = (src, srcset = "", sizes = "") => {
          const image = new Image();
          image.sizes = sizes;
          image.srcset = srcset;
          if (src) image.src = src;
          return decoded(image);
        };

        /* A recording with a poster per theme gets the one that matches,
           here rather than in the markup, so only that one downloads. */
        const pickPosters = (doc) => {
          for (const video of doc.querySelectorAll("video[data-poster]"))
            video.setAttribute(
              "poster",
              (dark.matches && video.dataset.posterDark) ||
                video.dataset.poster,
            );
        };

        /* A recording is in once the browser stops fetching it, which it
           says with `suspend`. With preload="auto" that comes after the last
           byte. Where the browser caps preloading (iOS stops at the
           metadata) it comes sooner, so the page never waits on data that
           isn't coming. A video whose last source fails is in too, and so
           is one the browser won't start on without a tap, still
           NETWORK_EMPTY with its sources in. The listeners go on before any
           video exists, so no event slips past. */
        const settled = new WeakSet();
        const waiting = new WeakMap();
        const settle = ({ type, target }) => {
          const video =
            target.localName === "video"
              ? target
              : type === "error" &&
                  target.matches?.("video > source:last-of-type")
                ? target.parentElement
                : undefined;
          if (!video) return;
          settled.add(video);
          waiting.get(video)?.();
        };
        const watch = (target) => {
          for (const type of ["suspend", "error"])
            target.addEventListener(type, settle, true);
        };
        const loaded = (video) =>
          settled.has(video) || video.networkState === video.NETWORK_EMPTY
            ? undefined
            : new Promise((done) => waiting.set(video, done));

        watch(document);

        const domReady = new Promise((done) => {
          if (document.readyState !== "loading") done();
          else
            document.addEventListener("DOMContentLoaded", done, { once: true });
        });

        const pageLoaded = domReady.then(() => {
          pickPosters(document);
          const videos = [...document.querySelectorAll("video")];
          return Promise.all([
            fontLoaded,
            document.fonts.ready,
            ...[...document.images].map(decoded),
            ...videos.map((video) => video.poster && warm(video.poster)),
            ...videos.map(loaded),
          ]);
        });

        /* Both handlers: a rejection here should still show the page. */
        pageLoaded.then(reveal, reveal);

        /* The router's side: fetch the next page, then load all of it
           before swapping it in, so a client-side navigation arrives whole
           too. The incoming document is detached and loads nothing itself.
           Its images are warmed into the cache its elements then hit. Its
           recordings are copied into this document and loaded there, and
           the copies take their places in the swap. */
        const copies = new WeakMap();

        document.addEventListener("astro:before-preparation", (event) => {
          const load = event.loader;
          event.loader = async () => {
            await load();
            const next = event.newDocument;
            pickPosters(next);
            const videos = [...next.querySelectorAll("video")].map((video) => {
              const copy = document.importNode(video, true);
              watch(copy);
              return copy;
            });
            copies.set(next, videos);
            await Promise.all([
              ...[...next.images].map((img) => {
                /* Inside a <picture>, warm the source the browser will pick
                   for this theme, not the fallback. */
                const source = img.parentElement?.matches("picture")
                  ? [...img.parentElement.querySelectorAll("source")].find(
                      (s) => !s.media || matchMedia(s.media).matches,
                    )
                  : undefined;
                return source
                  ? warm("", source.srcset, source.sizes)
                  : warm(img.src, img.srcset, img.sizes);
              }),
              ...videos.map((video) => video.poster && warm(video.poster)),
              ...videos.map(loaded),
            ]);
          };
        });

        document.addEventListener("astro:before-swap", (event) => {
          const videos = copies.get(event.newDocument);
          if (!videos?.length) return;
          const swap = event.swap;
          event.swap = () => {
            swap();
            document
              .querySelectorAll("video")
              .forEach((video, i) => videos[i] && video.replaceWith(videos[i]));
          };
        });

        /* Back to top glides up, unless motion is turned down, and leaves no
           #top in the address. The router leaves a handled click alone, and
           without JS the link still goes there itself. Pressed from the
           keys, focus goes to the top too, so they carry on from there; a
           tap or a click leaves it, or Safari rings the name. A click from
           the keys is the one with no count. */
        document.addEventListener("click", (event) => {
          if (!event.target.closest?.('a[href="#top"]')) return;
          event.preventDefault();
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          scrollTo({ top: 0, behavior: still ? "instant" : "smooth" });
          if (event.detail === 0)
            document.querySelector(".side a")?.focus({ preventScroll: true });
        });

        /* Where the side heads the page and scrolls away with it, a page
           with a heading of its own, every page but the homepage, which the
           side heads, comes in at its content, not under the side, which is
           one scroll up. The hairline over the content goes just out of
           view, so the first line is as far from the top as it was from the
           hairline. The router has just put the page at its top, and the
           cross-fade hasn't taken its picture of it yet. Not on the way back
           or forward, which keeps its place, nor to a link with a fragment,
           which goes there. */
        let pastSide = false;
        document.addEventListener("astro:before-swap", (event) => {
          pastSide = event.navigationType !== "traverse" && !event.to.hash;
        });
        document.addEventListener("astro:after-swap", () => {
          const main = document.querySelector("main");
          const side = document.querySelector(".side");
          if (!pastSide || !main.querySelector("h1")) return;
          if (getComputedStyle(side).position === "sticky") return;
          /* Rounded up: the browser rounds a scroll down, which would leave
             a sliver of the hairline at the top. */
          const top = main.getBoundingClientRect().top + scrollY + main.clientTop;
          scrollTo({ top: Math.ceil(top), behavior: "instant" });
        });

        /* Safari on iPhone only marks a link :active under a finger, for
           the press in global.css, when the page listens for touches. */
        document.addEventListener("touchstart", () => {}, { passive: true });

        /* Between pages the content cross-fades, where the browser can (see
           "between pages" in global.css). The content on its way out gets a
           name of its own, so it fades where it stands instead of pairing
           up with the incoming content and sliding from one scroll position
           to the other. The incoming page is marked, so it skips the fade-in
           of a fresh load: the cross-fade brings it in. */
        if (document.startViewTransition) {
          document.addEventListener("astro:before-preparation", () =>
            document
              .querySelector("main")
              ?.style.setProperty("view-transition-name", "content-out"),
          );
          document.addEventListener("astro:before-swap", (event) => {
            event.newDocument.documentElement.dataset.navigated = "";
          });

          /* Where the side heads the page, a navigation can move it: past
             it to the content, or back up to it. Then it cross-fades like
             the content, out where it stood and in where it lands, named
             apart the same way, instead of jumping. Where it stays put it's
             left out, so it's never a snapshot of itself. Whether it moves
             is known once the next page is in, before the picture of this
             one: a heading of its own, which it lands past, or the place it
             goes back to. */
          let sideFrom;
          document.addEventListener("astro:before-preparation", (event) => {
            const side = document.querySelector(".side");
            side.style.removeProperty("view-transition-name");
            sideFrom = undefined;
            if (getComputedStyle(side).position === "sticky") return;
            const load = event.loader;
            event.loader = async () => {
              await load();
              const lands =
                event.navigationType === "traverse"
                  ? (history.state?.scrollY ?? 0)
                  : event.to.hash
                    ? scrollY
                    : event.newDocument.querySelector("main h1")
                      ? Infinity
                      : 0;
              if (lands !== scrollY && side.getBoundingClientRect().bottom > 0)
                side.style.setProperty("view-transition-name", "side-out");
              sideFrom = scrollY;
            };
          });
          document.addEventListener("astro:after-swap", () => {
            const side = document.querySelector(".side");
            if (sideFrom === undefined || scrollY === sideFrom) return;
            if (side.getBoundingClientRect().bottom > 0)
              side.style.setProperty("view-transition-name", "side-in");
          });
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      /* The ICO is for browsers without SVG icons. Its `sizes` keeps Chrome
        from picking it over the SVG, which flips to a white tile in dark mode. */
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={feed}
    />
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      publishedTime && (
        <meta property="article:author" content={`${site.url}/`} />
      )
    }
    <meta name="twitter:card" content="summary" />
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <Mesh />

    {
      /* The same side on every page, so a navigation only changes the page
        beside it. */
    }
    <div class="wrap shell">
      <header class="side">
        <div class="title">
          <Name class="name">
            <a href="/" aria-current={path === "/" ? "page" : undefined}
              >{site.name}</a
            >
          </Name>
          <p class="subtitle">Software designer, builder, and painter.</p>
          <p>Based in Cluj-Napoca, Romania.</p>
        </div>

        <nav class="tabs" aria-label="Sections">
          {
            sections.map((s) => (
              <a
                href={s.href}
                aria-current={
                  path === s.href ? "page" : section === s.id ? "true" : undefined
                }
              >
                {s.label}
              </a>
            ))
          }
        </nav>

        <nav class="cta" aria-label="Elsewhere">
          {
            site.links.map((l) => {
              const newTab = l.href.startsWith("http");
              return (
                <a
                  href={l.href}
                  target={newTab ? "_blank" : undefined}
                  rel={newTab ? "noopener" : undefined}
                >
                  {l.label}
                </a>
              );
            })
          }
        </nav>
      </header>

      <main>
        <slot />
        {
          /* Where the side scrolls away with the page, the way back up to it.
            "#top" is the top of any page, without an element of that name. */
        }
        <p class="to-top"><a href="#top">Back to top</a></p>
      </main>
    </div>

    {
      /* The page fades out at the screen's top and bottom into copies of the
        background, paper and mesh, laid over it and shown only there, one
        pinned to each edge (see .edges in global.css). */
    }
    <div class="edges top" aria-hidden="true"><Mesh /></div>
    <div class="edges bottom" aria-hidden="true"><Mesh /></div>

    {
      /* Give Safari the colors for its bars over and under the page (see
        .tint in global.css). Kept through navigations, so the bars never
        change. */
    }
    <div class="tint top" aria-hidden="true" transition:persist="tint-top"></div>
    <div
      class="tint bottom"
      aria-hidden="true"
      transition:persist="tint-bottom"
    ></div>
  </body>
</html>
