---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { site, person } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  publishedTime?: Date;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  noindex = false,
  publishedTime,
  structuredData,
} = Astro.props;
const description = Astro.props.description ?? site.description;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} | Software Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const feed = new URL("/rss.xml", Astro.site);
const websiteId = `${site.url}/#website`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: "en",
      publisher: { "@id": person["@id"] },
    },
    {
      "@type": path === "/" ? "ProfilePage" : "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: pageTitle,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      ...(path === "/" && {
        mainEntity: { "@id": person["@id"] },
      }),
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
{
  /* No root crossfade: the swap is instant and the fade in global.css is the
    transition, so client navigations and hard loads look the same. */
}
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content="#fcfcfc"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0c"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      /* Holds the page until everything on it has loaded, fonts, images,
         posters and recordings, then lets the fade in global.css run — see
         `[data-loading]` there. Nothing on the site loads lazily. Inline and
         above the stylesheet so the attribute is set before the first paint.
         With JS off it is never set and the page renders as normal. */
      (() => {
        const root = document.documentElement;
        root.dataset.loading = "";

        const reveal = () => delete root.dataset.loading;
        const dark = matchMedia("(prefers-color-scheme: dark)");

        /* An image is in once it has decoded, or failed to. */
        const decoded = async (image) => {
          try {
            await image.decode();
          } catch {}
        };
        const warm = (src, srcset = "", sizes = "") => {
          const image = new Image();
          image.sizes = sizes;
          image.srcset = srcset;
          if (src) image.src = src;
          return decoded(image);
        };

        /* A recording with a poster per theme gets the one that matches,
           here rather than in the markup, so only that one downloads. */
        const pickPosters = (doc) => {
          for (const video of doc.querySelectorAll("video[data-poster]"))
            video.setAttribute(
              "poster",
              (dark.matches && video.dataset.posterDark) ||
                video.dataset.poster,
            );
        };

        /* A recording is in once the browser stops fetching it, which it
           says with `suspend`. With preload="auto" that comes after the last
           byte. Where the browser caps preloading (iOS stops at the
           metadata) it comes sooner, so the page never waits on data that
           isn't coming. A video whose last source fails is in too, and so
           is one the browser won't start on without a tap, still
           NETWORK_EMPTY with its sources in. The listeners go on before any
           video exists, so no event slips past. */
        const settled = new WeakSet();
        const waiting = new WeakMap();
        const settle = ({ type, target }) => {
          const video =
            target.localName === "video"
              ? target
              : type === "error" &&
                  target.matches?.("video > source:last-of-type")
                ? target.parentElement
                : undefined;
          if (!video) return;
          settled.add(video);
          waiting.get(video)?.();
        };
        const watch = (target) => {
          for (const type of ["suspend", "error"])
            target.addEventListener(type, settle, true);
        };
        const loaded = (video) =>
          settled.has(video) || video.networkState === video.NETWORK_EMPTY
            ? undefined
            : new Promise((done) => waiting.set(video, done));

        watch(document);

        const domReady = new Promise((done) => {
          if (document.readyState !== "loading") done();
          else
            document.addEventListener("DOMContentLoaded", done, { once: true });
        });

        const pageLoaded = domReady.then(() => {
          pickPosters(document);
          const videos = [...document.querySelectorAll("video")];
          return Promise.all([
            document.fonts.ready,
            ...[...document.images].map(decoded),
            ...videos.map((video) => video.poster && warm(video.poster)),
            ...videos.map(loaded),
          ]);
        });

        /* Both handlers: a rejection here should still show the page. */
        pageLoaded.then(reveal, reveal);

        /* The router's side: fetch the next page, then load all of it
           before swapping it in, so a client-side navigation arrives whole
           too. The incoming document is detached and loads nothing itself.
           Its images are warmed into the cache its elements then hit. Its
           recordings are copied into this document and loaded there, and
           the copies take their places in the swap. */
        const copies = new WeakMap();

        document.addEventListener("astro:before-preparation", (event) => {
          const load = event.loader;
          event.loader = async () => {
            await load();
            const next = event.newDocument;
            pickPosters(next);
            const videos = [...next.querySelectorAll("video")].map((video) => {
              const copy = document.importNode(video, true);
              watch(copy);
              return copy;
            });
            copies.set(next, videos);
            await Promise.all([
              ...[...next.images].map((img) => {
                /* Inside a <picture>, warm the source the browser will pick
                   for this theme, not the fallback. */
                const source = img.parentElement?.matches("picture")
                  ? [...img.parentElement.querySelectorAll("source")].find(
                      (s) => !s.media || matchMedia(s.media).matches,
                    )
                  : undefined;
                return source
                  ? warm("", source.srcset, source.sizes)
                  : warm(img.src, img.srcset, img.sizes);
              }),
              ...videos.map((video) => video.poster && warm(video.poster)),
              ...videos.map(loaded),
            ]);
          };
        });

        document.addEventListener("astro:before-swap", (event) => {
          const videos = copies.get(event.newDocument);
          if (!videos?.length) return;
          const swap = event.swap;
          event.swap = () => {
            swap();
            document
              .querySelectorAll("video")
              .forEach((video, i) => videos[i] && video.replaceWith(videos[i]));
          };
        });
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      /* The ICO is for browsers without SVG icons. Its `sizes` keeps Chrome
        from picking it over the SVG, which flips to a white tile in dark mode. */
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={feed}
    />
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      publishedTime && (
        <meta property="article:author" content={`${site.url}/`} />
      )
    }
    <meta name="twitter:card" content="summary" />
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer class="wrap">
      <div class="foot">
        <nav aria-label="Elsewhere">
          {
            site.links.map((l) => {
              const newTab = l.href.startsWith("http");
              return (
                <a
                  href={l.href}
                  target={newTab ? "_blank" : undefined}
                  rel={newTab ? "noopener" : undefined}
                >
                  {l.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </footer>
  </body>
</html>
